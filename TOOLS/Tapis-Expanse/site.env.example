# site.env -- the only file to edit. Values fill the {{PLACEHOLDERS}} in tapis/*.json.
# Environment variables with the same names override these. {{OTHER_KEY}} references work.

# --- Tapis ---------------------------------------------------------------------
TAPIS_BASE_URL=https://tacc.tapis.io      # your tenant's base URL
TAPIS_USERNAME=                    # or export TAPIS_JWT=<access token> instead

# --- Expanse -------------------------------------------------------------------
EXPANSE_USER=                         # account Tapis logs in as (the one SDSC set up)
EXPANSE_PROJECT=                      # allocation to charge, e.g. abc123 (expanse-client user)
SSH_PRIVATE_KEY_FILE=                 # passphrase-less key in that account's authorized_keys

# --- Tapis names ---------------------------------------------------------------
SYSTEM_ID=expanse-firetec
APP_ID=firetec
APP_VERSION=1.5.0                   # build_firetec.sh prints a suggested value

# --- Paths on Expanse (build_firetec.sh and make_smoke_cases.sh print these) ----
APP_ARCHIVE=/home/{{EXPANSE_USER}}/tapis-apps/firetec-1.5.0-75bdf50.tgz
CASES_DIR=/home/{{EXPANSE_USER}}/tapis-apps/firetec-cases
JOB_WORKING_DIR=/expanse/lustre/scratch/{{EXPANSE_USER}}/temp_project/tapis

# --- Only for tapis/jobs/example-compute.json ----------------------------------
MY_CASE_NAME=my-burn
# MY_CASE_DIR=/expanse/lustre/projects/CHANGE_ME/{{EXPANSE_USER}}/cases/my-burn
MY_CASE_DIR=/expanse/lustre/scratch/{{EXPANSE_USER}}/temp_project/tapis
# CASES_DIR=/home/{{EXPANSE_USER}}/tapis-apps/firetec-cases
